# PostgreSQL Database Configuration
# If PostgreSQL is not available, SQLite will be used automatically
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_risk_manager

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# SMTP Email Configuration (for sending OTP codes)
# For Gmail: use an App Password, not your regular password
# Go to https://myaccount.google.com/apppasswords to generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=RiskGuard

# If SMTP is not configured, OTP codes will be printed to the server console
